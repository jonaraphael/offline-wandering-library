  "static_link": "<a href=\"{{href}}\">{{text}}</a>",
  "static_trail": "<span class=\"trail\">{{folders}}<b>{{name}}</b></span>",
  "static_row": "<div class=\"row\"><b>{{title}}</b><small>{{detail}}</small>{{trail}}{{chapters}}</div>",
  "static_chapters": "<details><summary>Show chapters</summary><ul>{{items}}</ul></details>",
  "static_chapter": "<li>{{title}}<small>{{name}}</small></li>",
  "static_urgent": "<h2 class=\"label urgent\">Urgent</h2><div class=\"list urgent\">{{rows}}</div>",
  "static_tiles": "<h2 class=\"label\">Everything on this drive</h2><div class=\"tiles\">{{tiles}}</div>",
  "static_tile": "<a class=\"tile\" href=\"#c-{{id}}\" style=\"--c:var(--c-{{id}})\"><svg class=\"icon\" aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"{{icon}}\"/></svg>{{name}}<small>{{count}}</small></a>",
  "static_section": "<section class=\"shelf\" id=\"c-{{id}}\" style=\"--c:var(--c-{{id}})\"><div class=\"shelf-head\"><h2><span class=\"dot\" aria-hidden=\"true\"></span>{{name}}</h2><a class=\"back\" href=\"#top\">Top</a></div><p class=\"sub\">{{count}} · {{blurb}}</p><div class=\"list\">{{rows}}</div></section>",
  "static_archives": "<section class=\"panel\" id=\"kiwix\"><h2>Opening an encyclopedia</h2><p>On a computer, open START_HERE.html in a web browser. Encyclopedias open right on the page.</p><p>On a phone, use the free Kiwix app. Keep split files together and open the first part.</p>{{devices}}{{software}}</section>",
  "static_device": "<div class=\"device d-{{id}}\"><h3>{{name}}</h3><ol class=\"steps\"><li><span>{{install}}</span></li><li><span>{{open}}</span></li><li><span>{{pick}}</span></li></ol></div>",
  "static_software": "<div class=\"apps\"><h3>Reader apps on this drive</h3><div class=\"list\">{{rows}}</div></div>",
  "location_link": "<a href=\"{{href}}\">{{text}}</a>",
  "inventory_row": "<li>{{link}}<span class=\"where\">{{path}}</span>{{detail}}</li>",
  "report_row": "<li><b>{{title}}</b>{{detail}}</li>"
}
